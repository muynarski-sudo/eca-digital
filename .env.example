# Falando Francês Prática: variáveis de ambiente. Copie para .env (produção) ou .env.local (desenvolvimento).
# NUNCA commite o arquivo real. As chaves de serviço, de voz e de IA ficam só no servidor.

NEXT_TELEMETRY_DISABLED=1

# ---------- Site ----------
# URL pública (usada em e-mails e redirecionamentos). Em produção: https://seu-dominio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domínio para o HTTPS automático do Caddy (só produção, docker-compose)
APP_DOMAIN=app.exemplo.com.br
ACME_EMAIL=voce@exemplo.com.br

# ---------- Supabase ----------
# Local: rode `npm run db:start` e copie as chaves que o comando imprime.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVIDOR APENAS. Ignora a RLS. Usada no webhook, nos seeds, nos jobs e em convites.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta ao Postgres, usada só pelo backup diário (produção)
DATABASE_URL=postgresql://postgres:senha@db.exemplo.supabase.co:5432/postgres

# ---------- Hotmart ----------
# Token (hottok) mostrado no painel da Hotmart, aba Autenticação do webhook
HOTMART_HOTTOK=
# Dias de acesso concedidos a cada cobrança aprovada (mensal + margem)
HOTMART_PERIOD_DAYS=32
# true = envia convite por e-mail a quem comprou e ainda não tem conta
HOTMART_AUTO_INVITE=false

# ---------- Voz (opcional; sem chave usa o provider simulado) ----------
# TTS: gera os áudios de referência (npm run audio:generate). Transfere TEXTO ao provedor.
TTS_PROVIDER=mock            # mock | openai (API compatível com /v1/audio/speech)
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com
TTS_MODEL=tts-1
TTS_VOICE=alloy
# STT: transcreve a fala do aluno. Transfere ÁUDIO ao provedor.
STT_PROVIDER=mock            # mock | openai (API compatível com /v1/audio/transcriptions)
STT_API_KEY=
STT_BASE_URL=https://api.openai.com
STT_MODEL=whisper-1

# ---------- Conversa guiada por IA (desligada por padrão) ----------
AI_CONVERSATION_ENABLED=false
AI_API_KEY=
AI_MODEL=

# ---------- E-mail (lembretes de tarefa; sem SMTP só registra no console) ----------
SMTP_URL=                    # ex.: smtps://usuario:senha@smtp.exemplo.com:465
EMAIL_FROM="Falando Francês <nao-responda@exemplo.com.br>"

# ---------- Fuso dos jobs ----------
TZ=America/Sao_Paulo
