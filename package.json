{
  "name": "falando-frances-pratica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:build": "tsx scripts/content-build.ts",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:seed": "tsx --conditions=react-server scripts/content-seed.ts",
    "audio:generate": "tsx --conditions=react-server scripts/audio-generate.ts",
    "db:seed-dev": "tsx --conditions=react-server scripts/seed-dev.ts",
    "jobs:purge-recordings": "tsx --conditions=react-server scripts/jobs.ts purge-recordings",
    "jobs:reminders": "tsx --conditions=react-server scripts/jobs.ts reminders",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "check": "npm run typecheck && npm run lint && npm run content:validate && npm test",
    "dev:local": "APP_BACKEND=local next dev",
    "start:local": "APP_BACKEND=local next build && APP_BACKEND=local next start",
    "local:reset": "rm -rf .local-data",
    "audio:play": "tsx scripts/play-texts.ts && python3 scripts/play_audio.py --voice ${PIPER_VOICE:-voices/fr_FR-siwis-medium.onnx}",
    "audio:reading": "tsx scripts/reading-texts.ts && python3 scripts/play_audio.py --voice ${PIPER_VOICE:-voices/fr_FR-siwis-medium.onnx} --texts .audio-cache/reading-texts.json --out public/audio/reading"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
